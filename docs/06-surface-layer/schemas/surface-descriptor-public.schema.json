{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://initkoa.org/schemas/koali/surface-descriptor-public.v1.1.schema.json",
  "title": "Koali SurfaceDescriptorPublic v1.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "surfaceId",
    "moduleId",
    "routeId",
    "kind",
    "status",
    "presentation"
  ],
  "properties": {
    "surfaceId": {
      "type": "string",
      "minLength": 1
    },
    "moduleId": {
      "type": "string",
      "minLength": 1
    },
    "routeId": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "enum": [
        "local_shell_page",
        "registered_component_surface",
        "local_module_surface"
      ]
    },
    "status": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "access",
        "runtime",
        "connectivity",
        "render"
      ],
      "properties": {
        "access": {
          "enum": [
            "allowed",
            "blocked"
          ]
        },
        "runtime": {
          "enum": [
            "inactive",
            "starting",
            "ready",
            "degraded",
            "failed",
            "missing"
          ]
        },
        "connectivity": {
          "enum": [
            "online",
            "offline",
            "unknown"
          ]
        },
        "render": {
          "enum": [
            "idle",
            "resolving",
            "loading",
            "ready",
            "error"
          ]
        }
      }
    },
    "presentation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "immersiveAllowed"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "accentTokenRef": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
        },
        "immersiveAllowed": {
          "type": "boolean"
        },
        "defaultMode": {
          "enum": [
            "framed",
            "immersive"
          ],
          "default": "framed"
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "embedSrc",
        "iframeTitle",
        "sandboxTokens",
        "browserPermissions"
      ],
      "properties": {
        "embedSrc": {
          "type": "string",
          "minLength": 1
        },
        "iframeTitle": {
          "type": "string",
          "minLength": 1
        },
        "sandboxTokens": {
          "type": "array",
          "items": {
            "enum": [
              "allow-downloads",
              "allow-forms",
              "allow-modals",
              "allow-orientation-lock",
              "allow-pointer-lock",
              "allow-popups",
              "allow-popups-to-escape-sandbox",
              "allow-presentation",
              "allow-same-origin",
              "allow-scripts",
              "allow-storage-access-by-user-activation",
              "allow-top-navigation-by-user-activation"
            ]
          },
          "uniqueItems": true
        },
        "browserPermissions": {
          "type": "array",
          "items": {
            "enum": [
              "autoplay",
              "camera",
              "clipboard-read",
              "clipboard-write",
              "display-capture",
              "encrypted-media",
              "fullscreen",
              "geolocation",
              "microphone",
              "payment",
              "picture-in-picture",
              "publickey-credentials-get",
              "screen-wake-lock",
              "web-share"
            ]
          },
          "uniqueItems": true
        },
        "bridgeProtocolRef": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
