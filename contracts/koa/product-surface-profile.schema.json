{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.koa.local/artifact-contracts/product-surface-profile.schema.json",
  "title": "Koali Product Surface Profile",
  "description": "Declarative projection of one product interface for a specific user/work context. It selects existing product-owned routes, navigation items, widgets, commands and optional inspector contribution without duplicating business pages.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "surface_id",
    "label",
    "home_route_id"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "surface_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[_-][a-z0-9]+)*$"
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "label_key": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
    },
    "home_route_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
    },
    "required_capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "navigation_item_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
      }
    },
    "topbar_widget_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
      }
    },
    "command_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "inspector_ref": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "density": {
      "enum": [
        "comfortable",
        "compact",
        "touch"
      ]
    }
  }
}
