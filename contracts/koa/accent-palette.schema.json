{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.koa.local/artifact-contracts/accent-palette.schema.json",
  "title": "Koali Accent Palette",
  "description": "Canonical local registry of user-selectable Koali accent identities and colors.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "default_accent", "accents"],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": 1 },
    "default_accent": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*$" },
    "accents": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "color"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*$" },
          "label": { "type": "string", "minLength": 1, "maxLength": 80 },
          "color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" }
        }
      }
    }
  }
}
