  "sources": [
    {
      "id": "konnaxion_worlds",
      "publicName": "Konnaxion Worlds Engine",
      "repoEnv": "KOALI_REPO_KONNAXION_WORLDS",
      "directoryNames": [
        "Konnaxion_Worlds"
      ],
      "markers": [
        "backend/pyproject.toml",
        "backend/konnaxion/worlds/apps.py"
      ],
      "kind": "domain_engine",
      "integrationMode": "qualified_sibling_engine",
      "referenceOnly": false,
      "description": "Moteur canonique Universe/World consommé par Konnaxion; propriété séparée, version/digest verrouillés par Konnaxion.",
      "qualification": {
        "checks": [
          {
            "id": "world-engine-package",
            "kind": "file",
            "path": "backend/konnaxion/worlds/apps.py"
          },
          {
            "id": "pinned-identity",
            "kind": "command",
            "cwd": ".",
            "command": {
              "win32": "..\\Konnaxion\\backend\\.venv\\Scripts\\python.exe",
              "default": "../Konnaxion/backend/.venv/bin/python"
            },
            "args": [
              "../Konnaxion/scripts/check_worlds_dependency.py",
              "."
            ],
            "timeoutMs": 30000
          }
        ]
      },
      "requiredForBootstrap": true
    },
    {
      "id": "koa_mediatheque_blank_instance",
      "publicName": "Médiathèque Blank Instance",
      "repoEnv": "KOALI_REPO_KOA_MEDIATHEQUE_INSTANCE",
      "directoryNames": [
        "mediatheque-blank"
      ],
      "markers": [
        "mediatheque.instance.toml",
        "01_DB",
        "02_STORAGE"
      ],
      "kind": "local_data_instance",
      "integrationMode": "qualified_sibling_instance",
      "referenceOnly": false,
      "description": "Instance locale vierge et persistante utilisée par le moteur Médiathèque; données séparées du code du moteur.",
      "qualification": {
        "checks": [
          {
            "id": "instance-config",
            "kind": "file",
            "path": "mediatheque.instance.toml"
          },
          {
            "id": "sqlite-schema",
            "kind": "command",
            "cwd": ".",
            "command": {
              "win32": "..\\mediatheque\\.venv\\Scripts\\python.exe",
              "default": "../mediatheque/.venv/bin/python"
            },
            "args": [
              "-c",
              "import sqlite3; from pathlib import Path; p=Path('01_DB/koa_mediatheque.sqlite'); assert p.is_file(), 'database missing'; c=sqlite3.connect(p); r=c.execute(\"select value from schema_meta where key='schema_version'\").fetchone(); c.close(); assert r and r[0], 'schema_version missing'; print('schema_version='+str(r[0]))"
            ],
            "timeoutMs": 15000
          }
        ]
      },
      "requiredForBootstrap": true
    },
    {
