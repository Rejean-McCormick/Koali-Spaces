{
  "schemaVersion": 1,
  "productId": "koa_mediatheque",
  "owner": "Médiathèque kOA",
  "variables": {
    "webPort": {
      "type": "port",
      "env": "KOALI_KOA_MEDIATHEQUE_PORT",
      "default": 8501
    }
  },
  "surface": {
    "embedBase": "http://127.0.0.1:${webPort}"
  },
  "processes": [
    {
      "id": "web-windows",
      "platforms": [
        "win32"
      ],
      "cwd": ".",
      "command": {
        "env": "KOALI_PWSH",
        "default": "pwsh.exe"
      },
      "args": [
        "-NoLogo",
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "Start-KoaGui.ps1",
        "-HostName",
        "127.0.0.1",
        "-Port",
        "${webPort}"
      ],
      "probeId": "web"
    },
    {
      "id": "web-posix",
      "platforms": [
        "linux",
        "darwin"
      ],
      "cwd": ".",
      "command": {
        "env": "KOALI_PYTHON",
        "default": "python3"
      },
      "args": [
        "-m",
        "streamlit",
        "run",
        "06_GUI/koa_mediatheque_gui/app.py",
        "--server.address",
        "127.0.0.1",
        "--server.port",
        "${webPort}",
        "--server.headless",
        "true"
      ],
      "probeId": "web"
    }
  ],
  "probes": [
    {
      "id": "web",
      "url": "http://127.0.0.1:${webPort}/_stcore/health",
      "required": true,
      "statuses": [
        200
      ],
      "timeoutMs": 1800
    }
  ]
}
